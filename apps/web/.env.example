VITE_SANITY_PROJECT_ID=dh94bf5m
VITE_SANITY_DATASET=production

# Public URL of the Sanity Studio — used by stega to build click-to-edit links.
# Local studio: http://localhost:3333 · Production: your deployed studio URL.
VITE_SANITY_STUDIO_URL=http://localhost:3333

# Google Calendar Appointment Scheduling URL
# Create an Appointment Schedule at calendar.google.com → paste the booking page URL here
# e.g. https://calendar.google.com/calendar/appointments/schedules/ABC123...
# Opens in a new tab (Google blocks iframe embedding from external origins)
VITE_GOOGLE_CALENDAR_URL=

# Server-only secrets (not prefixed with VITE_)
SANITY_WRITE_TOKEN=
# Viewer token (from https://www.sanity.io/manage) used to fetch draft content
# for Presentation/Visual Editing previews.
SANITY_API_READ_TOKEN=

# Zoho SMTP — use an app-specific password from Zoho security settings
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
