VITE_SANITY_PROJECT_ID=ugjhuor8
VITE_SANITY_DATASET=production

# Google Calendar Appointment Scheduling URL
# Create an Appointment Schedule at calendar.google.com → paste the booking page URL here
# e.g. https://calendar.google.com/calendar/appointments/schedules/ABC123...
# Opens in a new tab (Google blocks iframe embedding from external origins)
VITE_GOOGLE_CALENDAR_URL=

# Server-only secrets (not prefixed with VITE_)
SANITY_WRITE_TOKEN=

# Zoho SMTP — use an app-specific password from Zoho security settings
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
