{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "SANITY_WRITE_TOKEN",
        "SANITY_API_READ_TOKEN",
        "ZOHO_EMAIL",
        "ZOHO_APP_PASSWORD",
        "SITE_URL",
        "SESSION_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
